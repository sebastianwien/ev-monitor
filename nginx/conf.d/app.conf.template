# Upstreams mit "resolve": nginx startet auch, wenn ein Dienst (noch) fehlt, und folgt
# neuen Container-IPs ohne Reload. Das Backend-Ziel steht in state/backend-upstream.conf;
# auf Prod schreibt der Blue/Green-Deploy die Datei um und lädt nginx neu.
resolver 127.0.0.11 valid=10s ipv6=off;
include /etc/nginx/state/backend-upstream.conf;

upstream connectors_app {
    zone connectors_app 64k;
    server connectors-service:8081 resolve;
}

upstream wallbox_app {
    zone wallbox_app 64k;
    server wallbox-service:8090 resolve;
}

upstream wallbox_ocpp {
    zone wallbox_ocpp 64k;
    server wallbox-service:9090 resolve;
}

# Intern (nur im Docker-Netz, nicht veröffentlicht): Connectors und Wallbox rufen
# http://backend_app auf, nginx trägt den Alias "backend" und leitet auf die aktive Farbe.
server {
    listen 8080;
    server_name _;
    server_tokens off;
    access_log off;

    client_max_body_size 100m;

    location / {
        proxy_pass http://backend_app;
        proxy_set_header Host $http_host;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

# HTTP - Redirect to HTTPS
server {
    listen 80;
    server_name ${DOMAIN};
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

map $http_user_agent $is_bot {
    default 0;
    "~*googlebot"               1;
    "~*google-inspectiontool"   1;
    "~*google-extended"         1;
    "~*bingbot"                 1;
    "~*yandexbot"               1;
    "~*duckduckbot"             1;
    "~*slurp"                   1;
    "~*facebookexternalhit"     1;
    "~*twitterbot"              1;
    "~*linkedinbot"             1;
    "~*whatsapp"                1;
    "~*discordbot"              1;
    "~*redditbot"               1;
    "~*redditbot-inbound"       1;
    "~*slackbot"                1;
    "~*telegrambot"             1;
    "~*mastodon"                1;
    "~*perplexitybot"           1;
    "~*claudebot"               1;
    "~*anthropic-ai"            1;
    "~*gptbot"                  1;
    "~*chatgpt-user"            1;
    "~*oai-searchbot"           1;
    "~*cohere-ai"               1;
    "~*applebot"                1;
    "~*ahrefsbot"               1;
    "~*semrushbot"              1;
}

# HTTPS
server {
    listen 443 ssl http2;
    server_name ${DOMAIN};
    server_tokens off;

    client_max_body_size 5m;

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # SSL Configuration (Mozilla Intermediate)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Security Headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Statische Upstream-Namen statt Variablen, damit die URI-Pfade in proxy_pass gelten.
    # Frontend: /srv/frontend/current ist auf Prod ein Symlink auf das aktive Release.

    # Tesla Fleet API public key (required for partner registration)
    location /.well-known/appspecific/ {
        alias /usr/share/nginx/well-known/appspecific/;
        add_header Content-Type text/plain;
    }

    # Android TWA verification (Digital Asset Links)
    location = /.well-known/assetlinks.json {
        root /srv/frontend/current;
        add_header Content-Type application/json;
        add_header Access-Control-Allow-Origin "*";
    }

    # Prerender for bots on public SEO pages (all markets)
    location ~* ^/(modelle|ladekurve|fahrzeug|en|gb|us|no|se) {
        resolver 127.0.0.11 valid=10s;
        set $prerender 0;
        if ($is_bot = 1) {
            set $prerender 1;
        }
        set $prerender_url "http://prerender:3000/https://ev-monitor.net$request_uri";
        if ($prerender = 1) {
            access_log /var/log/nginx/prerender.log prerender;
            proxy_pass $prerender_url;
        }
        root /srv/frontend/current;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # Serve Frontend PWA (with Prerender for bots on landing page)
    location = / {
        resolver 127.0.0.11 valid=10s;
        set $prerender 0;
        if ($is_bot = 1) {
            set $prerender 1;
        }
        set $prerender_url "http://prerender:3000/https://ev-monitor.net/";
        if ($prerender = 1) {
            access_log /var/log/nginx/prerender.log prerender;
            proxy_pass $prerender_url;
        }
        root /srv/frontend/current;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # Block source-map scanner abuse (URLs like /assets/index.js:1:12345)
    location ~ ":[0-9]" {
        return 404;
    }

    # index.html must never be cached - stale index.html references old asset hashes
    # that no longer exist after a deploy, causing "text/html is not valid JS MIME type"
    location = /index.html {
        root /srv/frontend/current;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        expires 0;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # Service Worker - must never be cached so browsers always get the latest version
    # Stale sw.js can reference workbox files from old deployments that no longer exist
    location = /sw.js {
        root /srv/frontend/current;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        expires 0;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    location = /sitemap.xml {
        proxy_pass http://backend_app/sitemap.xml;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Gehashte Assets: offene Tabs mit altem index.html laden nach einem Deploy noch
    # Chunks des vorherigen Releases nach. Fehlt die Datei auch dort: 404 statt index.html.
    location /assets/ {
        root /srv/frontend/current;
        try_files $uri @previous_assets;
    }

    location @previous_assets {
        root /srv/frontend/previous;
        try_files $uri =404;
    }

    location / {
        root /srv/frontend/current;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # Health check endpoint (public, fuer Uptime-Monitoring)
    location = /actuator/health {
        proxy_pass http://backend_app/actuator/health;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Proxy Connectors Service (Tesla Fleet + go-eCharger Cloud)
    # Must appear before the generic /api/ block to take precedence

    # XPeng Excel-Import: EU-Data-Act-Exports koennen ~30-50 MB gross sein, groessere Zeitraeume mehr
    location /api/imports/xpeng/ {
        client_max_body_size 100m;
        proxy_pass http://backend_app/api/imports/xpeng/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 120s;
    }

    # EU-Data-Act-Import (VW): User laden ZIP oder entpackte JSON hoch - entpackt sind das
    # 24-46 MB. Backend deckelt selbst auf 64 MB und liefert dafuer eine saubere Fehlermeldung;
    # der Wert hier ist bewusst hoeher, damit nginx nicht vorher mit einer 413-Seite abbricht.
    location /api/import/eu-data-act/ {
        client_max_body_size 100m;
        proxy_pass http://backend_app/api/import/eu-data-act/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 120s;
    }

    # VW EU-Data-Act-AutoSync: das Verbinden (einziger Schritt mit Passwort) liegt im Core
    # (oeffentliches Repo, VwEudaLoginClient). Regex-Locations gewinnen gegen Prefix-Locations,
    # deshalb greift diese Regel vor /api/eu-data-act/ unabhaengig von der Reihenfolge.
    location ~ ^/api/eu-data-act/cars/[^/]+/connect$ {
        proxy_pass http://backend_app;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 120s;
    }

    # Status, Trennen, Historie, Smartcar-Reaktivierung: Connectors-Service
    location /api/eu-data-act/ {
        proxy_pass http://connectors_app/api/eu-data-act/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_buffering off;
    }

    location /api/tesla/ {
        proxy_pass http://connectors_app/api/tesla/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_buffering off;
    }

    location /api/smartcar/ {
        proxy_pass http://connectors_app/api/smartcar/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_buffering off;
    }

    location /api/goe/ {
        proxy_pass http://connectors_app/api/goe/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_buffering off;
    }

    # Swagger UI + OpenAPI docs
    location /swagger-ui/ {
        proxy_pass http://backend_app/swagger-ui/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /v3/api-docs {
        proxy_pass http://backend_app/v3/api-docs;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Proxy API requests to backend (must come after specific /api/ blocks)
    location /api/ {
        proxy_pass http://backend_app/api/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_buffering off;
    }

    # Proxy Wallbox REST API
    location /api/wallbox/ {
        proxy_pass http://wallbox_app/api/wallbox/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_buffering off;
    }

    # Proxy OCPP WebSocket to wallbox-service (OCPP 1.6 runs on port 9090, not 8090)
    location /ocpp/ws/ {
        proxy_pass http://wallbox_ocpp/ocpp/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Proxy OAuth2 requests to backend
    location /oauth2/ {
        proxy_pass http://backend_app/oauth2/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /login/oauth2/ {
        proxy_pass http://backend_app/login/oauth2/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
